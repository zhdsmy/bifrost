#!/bin/sh
# Mock of cru: jobs in $MOCK_STATE/cru.txt as "<spec> #<name>#" lines.
f=$MOCK_STATE/cru.txt
touch "$f"
echo "CRU $*" >>"$MOCK_STATE/cru.log"
case "$1" in
    a)
        grep -v "#$2#\$" "$f" >"$f.t"
        printf '%s #%s#\n' "$3" "$2" >>"$f.t"
        mv "$f.t" "$f"
        ;;
    d)
        grep -v "#$2#\$" "$f" >"$f.t"
        mv "$f.t" "$f"
        ;;
    l) cat "$f" ;;
esac
exit 0
