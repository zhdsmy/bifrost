#!/bin/sh
# SSH wrapper for the Bifrost Tailscale CLI (PLAN 4.1).
# Passes Bifrost's socket and forwards all arguments verbatim.

# The software center runs scripts with umask 0, which would make every
# directory and file we create world-writable.
umask 022

: "${BIFROST_LIB:=${BIFROST_KSROOT:-/koolshare}/bifrost/lib}"
# shellcheck source=plugin/bifrost/lib/env.sh
. "$BIFROST_LIB/env.sh"

exec "$BIFROST_CLI" "--socket=$BIFROST_SOCK" "$@"
